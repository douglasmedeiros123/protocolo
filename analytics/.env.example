# Copie para .env (que já está no .gitignore) e preencha com valores reais.
# NUNCA commite um arquivo com valores reais preenchidos.

# Meta Marketing API — token de sistema com acesso de leitura a insights da conta de anúncios
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_837771300886167

# Hotmart Payments API — OAuth client_credentials (Ferramentas > Credenciais na Hotmart)
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=

# Microsoft Clarity Data Export API — gerado em Configurações > Exportação de dados no projeto Clarity
CLARITY_API_TOKEN=

# GitHub — token com escopo "repo" (leitura de commits deste mesmo repositório para o histórico de LP).
# Nome prefixado com ANALYTICS_ para nunca ser confundido com o secret IG_TOKEN/GITHUB_TOKEN
# já usados pelo autopost do Instagram (ig_autopost/config.js) — são sistemas separados.
ANALYTICS_GITHUB_TOKEN=
GITHUB_REPO=douglasmedeiros123/protocolo
