{
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "anti-vacuo.ojogodolucro.com.br" }],
      "dest": "/teste-b/$1"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "nova.ojogodolucro.com.br" }],
      "dest": "/nova/$1"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "popup-teste.ojogodolucro.com.br" }],
      "dest": "/popup-teste/$1"
    },
    { "handle": "filesystem" }
  ]
}
